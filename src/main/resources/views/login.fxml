<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.LoginController"
           styleClass="root-pane"
           prefWidth="1280" prefHeight="800">

    <!-- Gradient Background -->
    <VBox styleClass="login-bg" alignment="CENTER" prefWidth="1280" prefHeight="800"/>

    <!-- Decorative blobs -->
    <StackPane>
        <Region styleClass="blob blob-1"/>
        <Region styleClass="blob blob-2"/>
    </StackPane>

    <!-- Main Content: split layout -->
    <HBox alignment="CENTER" spacing="0">

        <!-- Left Panel: Branding -->
        <VBox styleClass="login-brand-panel" alignment="CENTER" spacing="24"
              prefWidth="560" prefHeight="800">
            <Label styleClass="brand-logo-text" text="SKY"/>
            <Label styleClass="brand-logo-accent" text="JET"/>
            <Label styleClass="brand-tagline" text="Fly Beyond the Horizon"/>
            <Label styleClass="brand-sub"
                   text="Premium airline reservations&#10;for the modern traveller."
                   wrapText="true"/>
            <HBox alignment="CENTER" spacing="40" styleClass="brand-stats">
                <VBox alignment="CENTER" spacing="4">
                    <Label styleClass="brand-stat-num" text="48+"/>
                    <Label styleClass="brand-stat-lbl" text="Destinations"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label styleClass="brand-stat-num" text="2.4M"/>
                    <Label styleClass="brand-stat-lbl" text="Passengers"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label styleClass="brand-stat-num" text="99.1%"/>
                    <Label styleClass="brand-stat-lbl" text="On-Time"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Right Panel: Login Card -->
        <VBox alignment="CENTER" prefWidth="720" prefHeight="800">
            <VBox fx:id="loginCard" styleClass="login-card" alignment="CENTER"
                  spacing="20" maxWidth="440" maxHeight="600">
                <padding><Insets top="48" right="48" bottom="48" left="48"/></padding>

                <Label styleClass="login-title" text="Welcome Back"/>
                <Label styleClass="login-subtitle" text="Sign in to your SkyJet account"/>

                <!-- Email -->
                <VBox spacing="6">
                    <Label styleClass="form-label" text="Email Address"/>
                    <TextField fx:id="emailField"
                               styleClass="form-field"
                               promptText="you@example.com"
                               prefWidth="344"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="6">
                    <Label styleClass="form-label" text="Password"/>
                    <PasswordField fx:id="passwordField"
                                   styleClass="form-field"
                                   promptText="Enter your password"
                                   prefWidth="344"/>
                </VBox>

                <!-- Error -->
                <Label fx:id="errorLabel" styleClass="error-label"
                       text="" wrapText="true" maxWidth="344"/>

                <!-- Loading -->
                <Label fx:id="loadingLabel" styleClass="loading-label"
                       text="⟳  Authenticating…"/>

                <!-- Login Button -->
                <Button fx:id="loginBtn" styleClass="btn-primary"
                        text="Sign In" prefWidth="344"
                        onAction="#handleLogin"/>

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="6">
                    <Label styleClass="link-label" text="Don't have an account?"/>
                    <Button styleClass="btn-link" text="Create one"
                            onAction="#goToRegister"/>
                </HBox>

            </VBox>
        </VBox>

    </HBox>
</StackPane>
