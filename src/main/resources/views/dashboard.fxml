<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardController"
            styleClass="root-pane"
            prefWidth="1280" prefHeight="800">

    <!-- ═══════════════════════════ SIDEBAR ═══════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" prefHeight="800" spacing="4">
            <padding><Insets top="32" right="16" bottom="32" left="16"/></padding>

            <!-- Logo -->
            <VBox styleClass="sidebar-logo" alignment="CENTER" spacing="2">
                <Label styleClass="sidebar-logo-text" text="✈  SkyJet"/>
                <Label styleClass="sidebar-logo-sub"  text="Premium Aviation"/>
            </VBox>

            <Region prefHeight="28"/>

            <!-- Nav Items -->
            <Button styleClass="sidebar-btn sidebar-btn-active"
                    text="⌂   Dashboard" prefWidth="208" onAction="#goToDashboard"/>
            <Button styleClass="sidebar-btn"
                    text="✈   Search Flights" prefWidth="208" onAction="#goToSearch"/>
            <Button styleClass="sidebar-btn"
                    text="⊞   My Bookings" prefWidth="208" onAction="#goToBookings"/>
            <Button styleClass="sidebar-btn"
                    text="⚙   Admin Panel" prefWidth="208" onAction="#goToAdmin"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Info -->
            <VBox styleClass="sidebar-user-box" spacing="8" alignment="CENTER">
                <Label fx:id="userInitialsLabel" styleClass="sidebar-avatar" text="JC"/>
                <Label fx:id="userNameLabel"     styleClass="sidebar-user-name" text="James Carter"/>
                <Label fx:id="userRoleLabel"     styleClass="sidebar-user-role" text="Gold Member"/>
                <Button styleClass="btn-logout" text="Sign Out"
                        prefWidth="160" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════════════════ MAIN CONTENT ═══════════════════════ -->
    <center>
        <VBox fx:id="mainContent" styleClass="main-content" spacing="0">

            <!-- Top Navbar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="0" right="32" bottom="0" left="32"/></padding>
                <Label styleClass="topbar-title" text="Dashboard"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="topbar-date" text="Wednesday, May 2026"/>
                <Label styleClass="notif-icon" text="🔔"/>
                <Label styleClass="notif-badge" text="3"/>
            </HBox>

            <!-- Content Scroll -->
            <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="28">
                    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                    <!-- Hero Welcome Banner -->
                    <VBox styleClass="hero-banner" spacing="10">
                        <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
                        <Label fx:id="welcomeLabel"   styleClass="hero-title" text="Welcome back!"/>
                        <Label fx:id="welcomeSubLabel" styleClass="hero-sub"  text="Member since 2024  ·  Gold Member"/>
                        <HBox spacing="16">
                            <Button styleClass="btn-primary-sm" text="✈  Book a Flight" onAction="#quickSearch"/>
                            <Button styleClass="btn-outline-sm" text="📋  My Bookings"  onAction="#viewHistory"/>
                        </HBox>
                    </VBox>

                    <!-- Statistics Row -->
                    <HBox spacing="20">
                        <!-- Stat Card 1 -->
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8"
                              HBox.hgrow="ALWAYS">
                            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
                            <Label styleClass="stat-icon" text="✈"/>
                            <Label fx:id="statFlightsValue"  styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Total Flights"/>
                        </VBox>
                        <!-- Stat Card 2 -->
                        <VBox styleClass="stat-card stat-card-blue" alignment="CENTER" spacing="8"
                              HBox.hgrow="ALWAYS">
                            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
                            <Label styleClass="stat-icon" text="🎫"/>
                            <Label fx:id="statBookingsValue" styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Bookings Made"/>
                        </VBox>
                        <!-- Stat Card 3 -->
                        <VBox styleClass="stat-card stat-card-teal" alignment="CENTER" spacing="8"
                              HBox.hgrow="ALWAYS">
                            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
                            <Label styleClass="stat-icon" text="💺"/>
                            <Label fx:id="statSeatsValue" styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Seats Available"/>
                        </VBox>
                        <!-- Stat Card 4 -->
                        <VBox styleClass="stat-card stat-card-amber" alignment="CENTER" spacing="8"
                              HBox.hgrow="ALWAYS">
                            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>
                            <Label styleClass="stat-icon" text="🌍"/>
                            <Label fx:id="statRoutesValue" styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Routes"/>
                        </VBox>
                    </HBox>

                    <!-- Featured Destinations -->
                    <VBox spacing="16">
                        <Label styleClass="section-title" text="Featured Destinations"/>
                        <HBox spacing="16">
                            <!-- Destination Cards -->
                            <VBox styleClass="dest-card" alignment="BOTTOM_LEFT" spacing="6"
                                  HBox.hgrow="ALWAYS" prefHeight="160">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label styleClass="dest-city"    text="London"/>
                                <Label styleClass="dest-country" text="United Kingdom"/>
                                <Label styleClass="dest-price"   text="from $850"/>
                            </VBox>
                            <VBox styleClass="dest-card dest-card-2" alignment="BOTTOM_LEFT" spacing="6"
                                  HBox.hgrow="ALWAYS" prefHeight="160">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label styleClass="dest-city"    text="Dubai"/>
                                <Label styleClass="dest-country" text="United Arab Emirates"/>
                                <Label styleClass="dest-price"   text="from $420"/>
                            </VBox>
                            <VBox styleClass="dest-card dest-card-3" alignment="BOTTOM_LEFT" spacing="6"
                                  HBox.hgrow="ALWAYS" prefHeight="160">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label styleClass="dest-city"    text="New York"/>
                                <Label styleClass="dest-country" text="United States"/>
                                <Label styleClass="dest-price"   text="from $1,250"/>
                            </VBox>
                            <VBox styleClass="dest-card dest-card-4" alignment="BOTTOM_LEFT" spacing="6"
                                  HBox.hgrow="ALWAYS" prefHeight="160">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label styleClass="dest-city"    text="Singapore"/>
                                <Label styleClass="dest-country" text="Singapore"/>
                                <Label styleClass="dest-price"   text="from $950"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Quick Actions -->
                    <VBox spacing="16">
                        <Label styleClass="section-title" text="Quick Actions"/>
                        <HBox spacing="16">
                            <Button styleClass="quick-action-btn" prefWidth="200" prefHeight="80"
                                    text="✈  Search Flights" onAction="#quickSearch"/>
                            <Button styleClass="quick-action-btn" prefWidth="200" prefHeight="80"
                                    text="📋  View History" onAction="#viewHistory"/>
                            <Button styleClass="quick-action-btn" prefWidth="200" prefHeight="80"
                                    text="⚙  Admin Panel" onAction="#goToAdmin"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
