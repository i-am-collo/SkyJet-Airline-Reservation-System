# ============================================================
# SkyJet Backend - Application Configuration
# ============================================================
# Copy this file to application.properties and fill in your values.
#   cp application.properties.example application.properties
# ============================================================

# Application
spring.application.name=SkyJet Backend API
server.port=8080

# Database Configuration (Supabase - Direct Connection)
# Get these from your Supabase project → Settings → Database → Connection string
spring.datasource.url=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
spring.datasource.username=postgres
spring.datasource.password=YOUR_SUPABASE_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA/Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true

# Flyway - DISABLED (schema already exists in Supabase)
spring.flyway.enabled=false

# Logging
logging.level.root=INFO
logging.level.com.skyjet.backend=DEBUG
logging.level.org.springframework.web=DEBUG
logging.level.org.hibernate.SQL=DEBUG

# Security - JWT Configuration
app.jwt.secret=your-very-secure-secret-key-change-this-in-production-at-least-32-characters-long!
app.jwt.expiration=86400000

# CORS Configuration
app.cors.allowed-origins=http://localhost:3000,http://localhost:8080

# Jackson Configuration
spring.jackson.serialization.indent-output=true
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=UTC
