<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.BookingController"
            styleClass="root-pane"
            prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" prefHeight="800" spacing="4">
            <padding><Insets top="32" right="16" bottom="32" left="16"/></padding>
            <VBox styleClass="sidebar-logo" alignment="CENTER" spacing="2">
                <Label styleClass="sidebar-logo-text" text="✈  SkyJet"/>
                <Label styleClass="sidebar-logo-sub"  text="Premium Aviation"/>
            </VBox>
            <Region prefHeight="28"/>
            <Button styleClass="sidebar-btn"             text="⌂   Dashboard"     prefWidth="208" onAction="#goToDashboard"/>
            <Button styleClass="sidebar-btn"             text="✈   Search Flights" prefWidth="208" onAction="#goToSearch"/>
            <Button styleClass="sidebar-btn sidebar-btn-active" text="⊞   My Bookings"  prefWidth="208" onAction="#goToBookings"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button styleClass="btn-logout" text="Sign Out" prefWidth="208" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox styleClass="main-content" spacing="0">

            <!-- Topbar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="0" right="32" bottom="0" left="32"/></padding>
                <Label styleClass="topbar-title" text="Booking &amp; History"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="28">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                    <!-- ══════════ BOOKING FORM PANE ══════════ -->
                    <VBox fx:id="formPane" spacing="20">

                        <HBox spacing="20" alignment="TOP_LEFT">

                            <!-- LEFT: Flight Summary Card -->
                            <VBox styleClass="booking-summary-card" spacing="14" prefWidth="400">
                                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                                <Label styleClass="card-title" text="Flight Summary"/>

                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Flight"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryFlightNum"   styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Route"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryRoute"       styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Schedule"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryDeparture"   styleClass="summary-val" text="–" wrapText="true" maxWidth="200"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Aircraft"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryAircraft"    styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Seat"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summarySeat"        styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Class"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryClass"       styleClass="summary-val" text="–"/>
                                </HBox>

                                <Region prefHeight="8" styleClass="summary-divider"/>

                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Base Fare"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryBasePrice"   styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row">
                                    <Label styleClass="summary-key"   text="Taxes &amp; Fees (16%)"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryTax"         styleClass="summary-val" text="–"/>
                                </HBox>
                                <HBox styleClass="summary-row summary-total-row">
                                    <Label styleClass="summary-total-key" text="Total"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryTotal"       styleClass="summary-total-val" text="–"/>
                                </HBox>
                            </VBox>

                            <!-- RIGHT: Passenger Details Form -->
                            <VBox styleClass="passenger-form-card" spacing="14" HBox.hgrow="ALWAYS">
                                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                                <Label styleClass="card-title" text="Passenger Details"/>

                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Full Name *"/>
                                        <TextField fx:id="passengerNameField" styleClass="form-field"
                                                   promptText="As shown on passport" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Email Address *"/>
                                        <TextField fx:id="passengerEmailField" styleClass="form-field"
                                                   promptText="Contact email" maxWidth="Infinity"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Passport Number *"/>
                                        <TextField fx:id="passengerPassportField" styleClass="form-field"
                                                   promptText="e.g. A12345678" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Nationality"/>
                                        <ComboBox fx:id="nationalityCombo" styleClass="form-combo"
                                                  maxWidth="Infinity"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Date of Birth"/>
                                        <DatePicker fx:id="dobPicker" styleClass="form-combo"
                                                    maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="form-label" text="Meal Preference"/>
                                        <ComboBox fx:id="mealCombo" styleClass="form-combo"
                                                  maxWidth="Infinity"/>
                                    </VBox>
                                </HBox>

                                <!-- Terms notice -->
                                <Label styleClass="terms-note"
                                       text="By confirming this booking you agree to SkyJet's Terms &amp; Conditions and Privacy Policy."
                                       wrapText="true"/>

                                <!-- Confirm Button -->
                                <Button fx:id="confirmBtn" styleClass="btn-confirm"
                                        text="✔  Confirm Booking" prefWidth="300"
                                        onAction="#handleConfirmBooking"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ══════════ CONFIRMATION BANNER (hidden until booked) ══════════ -->
                    <VBox fx:id="confirmationPane" styleClass="confirmation-banner"
                          alignment="CENTER" spacing="16" visible="false">
                        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
                        <Label styleClass="confirmation-icon"  text="✔"/>
                        <Label styleClass="confirmation-title" text="Booking Confirmed!"/>
                        <Label fx:id="bookingRefLabel" styleClass="confirmation-ref"
                               text="Booking Reference: –"/>
                        <Label styleClass="confirmation-sub"
                               text="Your e-ticket has been sent to your email address."/>
                        <HBox spacing="16" alignment="CENTER">
                            <Button styleClass="btn-primary"     text="🖨  Print Ticket"   onAction="#printTicket"/>
                            <Button styleClass="btn-outline"     text="✈  Book Another"   onAction="#newBooking"/>
                        </HBox>
                    </VBox>

                    <!-- ══════════ BOOKING HISTORY ══════════ -->
                    <VBox spacing="14">
                        <Label styleClass="section-title" text="Booking History"/>
                        <TableView fx:id="historyTable" styleClass="flight-table"
                                   prefHeight="320">
                            <columns>
                                <TableColumn fx:id="colRef"    text="Ref #"       prefWidth="90"/>
                                <TableColumn fx:id="colFlight" text="Flight"      prefWidth="80"/>
                                <TableColumn fx:id="colRoute"  text="Route"       prefWidth="200"/>
                                <TableColumn fx:id="colDepart" text="Schedule"    prefWidth="170"/>
                                <TableColumn fx:id="colSeat"   text="Seat"        prefWidth="60"/>
                                <TableColumn fx:id="colClass"  text="Class"       prefWidth="90"/>
                                <TableColumn fx:id="colCost"   text="Cost"        prefWidth="90"/>
                                <TableColumn fx:id="colStatus" text="Status"      prefWidth="100"/>
                                <TableColumn fx:id="colDate"   text="Booked On"   prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No bookings yet. Start by searching for a flight!"
                                       styleClass="table-placeholder"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button styleClass="btn-danger" text="Cancel Selected Booking"
                                    onAction="#cancelSelectedBooking"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
