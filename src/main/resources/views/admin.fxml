<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AdminController"
            styleClass="root-pane"
            prefWidth="1280" prefHeight="800">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" prefHeight="800" spacing="4">
            <padding><Insets top="32" right="16" bottom="32" left="16"/></padding>
            <VBox styleClass="sidebar-logo" alignment="CENTER" spacing="2">
                <Label styleClass="sidebar-logo-text" text="✈  SkyJet"/>
                <Label styleClass="sidebar-logo-sub"  text="Admin Console"/>
            </VBox>
            <Region prefHeight="28"/>
            <Button styleClass="sidebar-btn sidebar-btn-active" text="⚙   Admin Panel"  prefWidth="208" onAction="#goToAdmin"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button styleClass="btn-logout" text="Sign Out" prefWidth="208" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox styleClass="main-content" spacing="0">

            <!-- Topbar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="0" right="32" bottom="0" left="32"/></padding>
                <Label styleClass="topbar-title" text="Admin Dashboard"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="admin-badge" text="ADMIN"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="28">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                    <!-- Statistics Row -->
                    <HBox spacing="20">
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                            <Label styleClass="stat-icon" text="✈"/>
                            <Label fx:id="statTotalFlights"  styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Total Flights"/>
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                            <Label styleClass="stat-icon" text="🎫"/>
                            <Label fx:id="statTotalBookings" styleClass="stat-value" text="0"/>
                            <Label styleClass="stat-label" text="Total Bookings"/>
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                            <Label styleClass="stat-icon" text="💰"/>
                            <Label fx:id="statTotalRevenue"  styleClass="stat-value" text="$$0"/>
                            <Label styleClass="stat-label" text="Revenue (Demo)"/>
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                            <Label styleClass="stat-icon" text="📊"/>
                            <Label fx:id="statOccupancy"     styleClass="stat-value" text="–"/>
                            <Label styleClass="stat-label" text="Occupancy Rate"/>
                        </VBox>
                    </HBox>

                    <!-- Flight Management Table -->
                    <VBox spacing="14">
                        <Label styleClass="section-title" text="Flight Management"/>
                        <TableView fx:id="flightTable" styleClass="flight-table" prefHeight="300">
                            <columns>
                                <TableColumn fx:id="colFlightNum"   text="Flight #"   prefWidth="85"/>
                                <TableColumn fx:id="colAirline"     text="Airline"    prefWidth="80"/>
                                <TableColumn fx:id="colOrigin"      text="From"       prefWidth="140"/>
                                <TableColumn fx:id="colDestination" text="To"         prefWidth="140"/>
                                <TableColumn fx:id="colDeparture"   text="Departs"   prefWidth="72"/>
                                <TableColumn fx:id="colArrival"     text="Arrives"   prefWidth="72"/>
                                <TableColumn fx:id="colPrice"       text="Price"     prefWidth="72"/>
                                <TableColumn fx:id="colSeats"       text="Seats"     prefWidth="60"/>
                                <TableColumn fx:id="colStatus"      text="Status"    prefWidth="90"/>
                            </columns>
                            <placeholder>
                                <Label text="No flights in the system." styleClass="table-placeholder"/>
                            </placeholder>
                        </TableView>

                        <!-- Action buttons row -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button styleClass="btn-danger"  text="🗑  Delete Selected"  onAction="#handleDeleteFlight"/>
                            <Button styleClass="btn-outline" text="✏  Update Selected"  onAction="#handleUpdateFlight"/>
                            <Button styleClass="btn-outline" text="✖  Clear Form"        onAction="#clearForm"/>
                        </HBox>
                    </VBox>

                    <!-- Add / Edit Flight Form -->
                    <VBox styleClass="admin-form-card" spacing="16">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="card-title" text="Add / Edit Flight"/>
                            <Label fx:id="formStatusLabel" styleClass="form-status-label" text=""/>
                        </HBox>

                        <!-- Row 1 -->
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Flight Number *"/>
                                <TextField fx:id="fldFlightNum" styleClass="form-field"
                                           promptText="e.g. SJ-101" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Airline"/>
                                <TextField fx:id="fldAirline" styleClass="form-field"
                                           promptText="e.g. SkyJet" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Aircraft Type"/>
                                <TextField fx:id="fldAircraft" styleClass="form-field"
                                           promptText="e.g. Boeing 787" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Status"/>
                                <ComboBox fx:id="cmbStatus" styleClass="form-combo" prefWidth="140"/>
                            </VBox>
                        </HBox>

                        <!-- Row 2 -->
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Origin *"/>
                                <TextField fx:id="fldOrigin" styleClass="form-field"
                                           promptText="e.g. Nairobi (NBO)" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Destination *"/>
                                <TextField fx:id="fldDestination" styleClass="form-field"
                                           promptText="e.g. London (LHR)" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Departure *"/>
                                <TextField fx:id="fldDeparture" styleClass="form-field"
                                           promptText="e.g. 08:00" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Arrival"/>
                                <TextField fx:id="fldArrival" styleClass="form-field"
                                           promptText="e.g. 20:15" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Duration"/>
                                <TextField fx:id="fldDuration" styleClass="form-field"
                                           promptText="e.g. 9h 15m" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>

                        <!-- Row 3 -->
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Price (USD) *"/>
                                <TextField fx:id="fldPrice" styleClass="form-field"
                                           promptText="e.g. 850" prefWidth="120"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Available Seats *"/>
                                <TextField fx:id="fldSeats" styleClass="form-field"
                                           promptText="e.g. 42" prefWidth="120"/>
                            </VBox>
                            <VBox spacing="6" alignment="BOTTOM_LEFT">
                                <Label styleClass="form-label" text=" "/>
                                <Button fx:id="btnAddFlight" styleClass="btn-primary"
                                        text="➕  Add Flight" prefHeight="40"
                                        onAction="#handleAddFlight"/>
                            </VBox>
                        </HBox>

                    </VBox>

                    <!-- Admin Booking View -->
                    <VBox spacing="14">
                        <Label styleClass="section-title" text="All Bookings"/>
                        <TableView fx:id="adminBookingsTable" styleClass="flight-table" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="adminColBookingRef" text="Ref #" prefWidth="100"/>
                                <TableColumn fx:id="adminColPassenger" text="Passenger" prefWidth="150"/>
                                <TableColumn fx:id="adminColBookingFlight" text="Flight" prefWidth="90"/>
                                <TableColumn fx:id="adminColBookingRoute" text="Route" prefWidth="220"/>
                                <TableColumn fx:id="adminColBookingSeat" text="Seat" prefWidth="70"/>
                                <TableColumn fx:id="adminColBookingCost" text="Cost" prefWidth="90"/>
                                <TableColumn fx:id="adminColBookingStatus" text="Status" prefWidth="110"/>
                                <TableColumn fx:id="adminColBookingDate" text="Booked On" prefWidth="120"/>
                            </columns>
                            <placeholder>
                                <Label text="No bookings found." styleClass="table-placeholder"/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button styleClass="btn-danger" text="✖  Cancel Selected Booking" onAction="#handleCancelBooking"/>
                        </HBox>
                    </VBox>

                    <!-- Admin Audit View -->
                    <VBox spacing="14">
                        <Label styleClass="section-title" text="Login Audits"/>
                        <TableView fx:id="auditTable" styleClass="flight-table" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="auditColEmail" text="Email" prefWidth="260"/>
                                <TableColumn fx:id="auditColStatus" text="Status" prefWidth="120"/>
                                <TableColumn fx:id="auditColTime" text="Login Time" prefWidth="180"/>
                            </columns>
                            <placeholder>
                                <Label text="No login audits found." styleClass="table-placeholder"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
